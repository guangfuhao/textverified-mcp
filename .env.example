# Required by TextVerified v2 bearer-token authentication.
# TEXTVERIFIED_USERNAME is the email used to register the TextVerified account.
TEXTVERIFIED_USERNAME=you@example.com
TEXTVERIFIED_API_KEY=replace-with-your-primary-api-key
TEXTVERIFIED_BASE_URL=https://www.textverified.com

# MCP transport: stdio (default) or sse, depending on your host.
TEXTVERIFIED_MCP_TRANSPORT=stdio
